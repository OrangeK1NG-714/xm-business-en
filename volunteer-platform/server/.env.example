DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/volunteer_platform
PORT=6101
ADMIN_ORIGIN=http://localhost:6102
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DEMO_MODE=true
SMS_PROVIDER=mock
SMS_NOTIFICATIONS_ENABLED=true
EXPORT_DIRECTORY=./data/exports
# Real SMS is only sent after setting all of these and SMS_PROVIDER=tencent.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
