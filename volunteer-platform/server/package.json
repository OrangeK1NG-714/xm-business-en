{
  "name": "@volunteer/server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/main.js",
    "worker": "node --env-file=.env dist/src/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test": "tsx --test src/*.test.ts",
    "test:integration": "tsx --env-file=.env scripts/integration.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pg-boss": "12.38.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tencentcloud-sdk-nodejs-sms": "4.1.306"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "7.8.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
